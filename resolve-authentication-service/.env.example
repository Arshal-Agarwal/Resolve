# ── Server ────────────────────────────────────────────────────────────────
PORT=4001
NODE_ENV=development
LOG_LEVEL=info

# ── Redis (owned persistence for this service — see Schemas/01_Authentication_Service_Schema.md) ──
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=resolve:auth:

# ── Dependency services (per Contracts/Authentication_Service.md §14) ──────
# When USE_MOCKS=true, the clients below point at the local mock server
# (mocks/server.js, started via `npm run mocks`) instead of the real
# User & Team / Organization services, so this service can be built and
# tested before teammates' services exist. Flip to false + set the real
# base URLs once those services are reachable.
USE_MOCKS=true
USER_TEAM_SERVICE_URL=http://localhost:4100
ORGANIZATION_SERVICE_URL=http://localhost:4200
RBAC_SERVICE_URL=http://localhost:4300
INTERNAL_SERVICE_TOKEN=dev-internal-service-token

# ── JWT / JWKS signing (RS256, per Contracts/Authentication_Service.md §3) ─
# Local dev: generated on first boot into src/keys/ if not already present,
# via the LocalFileSecretsProvider (see src/keys/secretsProvider.js).
# Production: this provider must be swapped for a real secrets backend —
JWT_KID=2026-09-key-1
JWT_ISSUER=resolve-authentication-service
JWT_PRIVATE_KEY_PATH=src/keys/private.pem
JWT_PUBLIC_KEY_PATH=src/keys/public.pem
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000

# ── Rate limiting (FR-RED-02, Schema §13 item 7: mandatory for login AND reset) ──
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
PASSWORD_RESET_RATE_LIMIT_MAX_ATTEMPTS=5
PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900

# ── Password reset (Contract §8) ────────────────────────────────────────────
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800

# ── MFA (TOTP) ────────────────────────────────────────────────────────────
# Generate once and keep stable across restarts/deployments:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do not commit the real key. Existing MFA secrets cannot be decrypted if this changes.

MFA_ENCRYPTION_KEY="get your key by running `node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\"`"
MFA_ISSUER=Resolve

