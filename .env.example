# Resolve Platform — shared infrastructure environment
#
# Copy to .env and adjust as needed. This file is for the root-level
# docker-compose.yml (Kafka infrastructure). Individual services have
# their own .env.example files for service-specific configuration.

# Kafka / Redpanda
# Host-based services (npm run dev) connect via localhost:9092.
# Docker-internal services connect via redpanda:9092 (when running in
# the same compose network).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Number of partitions for main domain-event topics.
# DLQ topics always get 1 partition regardless of this setting.
PARTITIONS=6
